# ────────────────────────────────────────────────────────────────────────
# .env.example — шаблон переменных окружения.
#
# СКОПИРУЙ В .env И ЗАПОЛНИ СВОИМИ НАСТРОЙКАМИ:
#   cp .env.example .env     (Linux/Mac)
#   copy .env.example .env   (Windows PowerShell)
#
# .env НЕ коммитится в git (добавлен в .gitignore).
# ────────────────────────────────────────────────────────────────────────

# Django core
DJANGO_SECRET_KEY=django-insecure-change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# ── Database: PostgreSQL ──
# ВАЖНО: заполните ВСЕ 6 переменных!
# Создайте базу заранее (см. SETUP_GUIDE.md)
#   (или через pgAdmin: Create → Database → amazone_clone)
#
# PostgreSQL adapter:
#   psycopg3 (psycopg[binary]) — РЕКОМЕНДУЕТСЯ (Django 4.2+)
#   psycopg2-binary — устаревший fallback
#   Django автоматически определяет, какой адаптер установлен.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=amazone_clone
DB_USER=postgres
DB_PASSWORD=change-me-to-your-password
DB_HOST=localhost
DB_PORT=5432

# Для SQLite (без PostgreSQL) — просто НЕ задайте DB_ENGINE,
# или закомментируйте все DB_ строки. Django использует SQLite по умолчанию.

# CORS — откуда React может обращаться к Django
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Throttling (по умолчанию 60/min anon, 120/min user)
THROTTLE_ANON=60/min
THROTTLE_USER=120/min
