# ── Coverage ──
htmlcov/
.coverage
.coverage.*
coverage/

# ── Docker ──
.docker/

# ── Logs ──
*.log

# ── Celery ──
celerybeat-schedule
celerybeat.pid

# ── Static files (collected) ──
staticfiles/

